# Supabase PostgreSQL backend (optional; falls back to local SQLite if not set)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LinkedIn auth (free direct OAuth v2)
# Register an app at https://developer.linkedin.com/ and add these products:
#   - Share on LinkedIn
#   - Sign In with LinkedIn using OpenID Connect
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Optional: override scopes (defaults to free personal scopes)
# LINKEDIN_SCOPES=openid profile email w_member_social

# Required: used to encrypt stored LinkedIn tokens in the local SQLite database.
# Generate a strong random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=your_random_secret_at_least_32_chars

# Hermes LLM routing will be configured separately by Hermes
# LLM_PROVIDER=openai|anthropic|local
# LLM_API_KEY=...

# Data directory override (default: repo/data)
# DATA_DIR=/opt/data/content-pipeline

# Human-in-the-loop: require approval before publishing (default: true)
# REQUIRE_APPROVAL=true

# LLM client settings (optional; rule-based drafting works without them)
# Default provider is Ollama running an OpenAI-compatible endpoint.
# LLM_PROVIDER=ollama
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_TIMEOUT=120

# MCP server bearer-token auth (set before exposing the server to any network)
# MCP_AUTH_TOKEN=generate_a_strong_random_token

# RunPod / ComfyUI image generation
# RUNPOD_API_KEY=your_runpod_api_key
# RUNPOD_POD_ID=your_pod_id
# COMFY_PROXY_URL=http://your-pod-ip:8188
# Seconds to wait after pod transitions to RUNNING before calling ComfyUI (default 300)
# COMFY_INIT_DELAY_SECONDS=300
# PAUSE_AFTER_SECONDS=300

# Review dashboard server
REVIEW_SERVER_HOST=0.0.0.0
REVIEW_SERVER_PORT=8080
REVIEW_DASHBOARD_SUBDOMAIN=review.hermes-agent-xqcr.srv1921473.hstgr.cloud


# Review dashboard HTTP Basic Auth password
REVIEW_PASSWORD=your-strong-review-password
